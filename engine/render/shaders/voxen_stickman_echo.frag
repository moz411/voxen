vec2 joint(int frame,int idx){return poses[frame*13+idx];}
vec2 positionAt(float t,int idx){
 float frame=mod(t*4.0,15.0);
 int a=int(floor(frame)),b=(a+1)%15;
 return mix(joint(a,idx),joint(b,idx),fract(frame));
}
float capsule(vec2 p,vec2 a,vec2 b,float r){
 vec2 q=p-a,v=b-a;
 return length(q-v*clamp(dot(q,v)/max(dot(v,v),.0000001),0.,1.))-r;
}
float stick(vec2 p,float t){
 vec2 j[13];
 for(int i=0;i<13;i++)j[i]=positionAt(t,i);
 float d=length(p-j[0])-.05141;
 d=min(d,capsule(p,j[1],j[2],.003));
 d=min(d,capsule(p,j[1],j[7],.003));
 d=min(d,capsule(p,j[2],j[8],.003));
 d=min(d,capsule(p,j[7],j[8],.003));
 d=min(d,capsule(p,j[1],j[3],.003));
 d=min(d,capsule(p,j[3],j[5],.003));
 d=min(d,capsule(p,j[2],j[4],.003));
 d=min(d,capsule(p,j[4],j[6],.003));
 d=min(d,capsule(p,j[7],j[9],.003));
 d=min(d,capsule(p,j[9],j[11],.003));
 d=min(d,capsule(p,j[8],j[10],.003));
 d=min(d,capsule(p,j[10],j[12],.003));
 return d;
}
void main(){
 float t=pc.parameters.x*pc.parameters.y;
 // Center the small original figure in the physical Voxen quad.
 vec2 p=uv*.42+vec2(.0,-.18);
 vec3 c=vec3(0.);
 float alpha=0.;
 for(int i=6;i>=1;i--){
   float d=stick(p,t-float(i)*.035);
   float strength=(1.-float(i)/7.)*.7;
   float m=1.-smoothstep(.001,.006,abs(d));
   c=mix(c,vec3(.1,.5,1.)*strength,m);
   alpha=max(alpha,m*strength);
 }
 float d=stick(p,t);
 float m=1.-smoothstep(.001,.005,abs(d));
 c=mix(c,vec3(1.),m);
 alpha=max(alpha,m);
 if(alpha<.01)discard;
 outColor=vec4(c,alpha*.97);
}
