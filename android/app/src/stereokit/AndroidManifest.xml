<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1"/>
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="true"/>
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR"/>
    <uses-permission android:name="com.oculus.permission.USE_ANCHOR_API"/>
    <uses-permission android:name="com.oculus.permission.USE_SCENE"/>
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM"/>
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker"/>
    </queries>
    <application android:allowBackup="false" android:hasCode="false" android:label="Voxen StereoKit">
        <meta-data android:name="com.oculus.ossplash.background" android:value="passthrough-contextual"/>
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s|questpro"/>
        <activity android:name="android.app.NativeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard"
            android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="landscape" android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="voxen"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD"/>
                <category android:name="com.oculus.intent.category.VR"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
